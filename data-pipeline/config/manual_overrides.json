{
  "_comment": "manual_overrides.json — Quick human edits that take priority over scraped / manual data.",

  "_usage": {
    "field_overrides": "Add a provider's ID as a key and any Provider fields as values to override them.",
    "_skip": "Set '_skip': true on a provider entry to exclude it from the output entirely (useful for hiding placeholder entries).",
    "_add_providers": "Add complete provider records here to inject them into the directory without touching sources.json."
  },

  "_available_fields": {
    "id":                     "string — stable slug (e.g. 'coreweave')",
    "provider_name":          "string",
    "layer_type":             "'GPU Cloud' | 'Bare-Metal' | 'Edge'",
    "hardware_architectures": "array of strings (e.g. ['NVIDIA H100', 'NVIDIA H200'])",
    "cooling_type":           "'Liquid' | 'Air' | 'Immersion' | 'Hybrid' | 'Unknown'",
    "jurisdiction_zone":      "'US-Federal' | 'EU-GDPR' | 'APAC-Singapore' | 'APAC-Japan' | 'UK' | 'Canada' | 'Australia' | 'Other / Multi'",
    "primary_location":       "string",
    "website":                "string — must start with https://",
    "total_gpus":             "integer or null",
    "network_bandwidth_gbps": "integer or null",
    "interconnect":           "string or null",
    "sla_uptime_percent":     "float 99.0–100.0 or null",
    "price_per_gpu_hour_usd": "float >= 0 or null",
    "certifications":         "array of strings",
    "availability_status":    "string (e.g. 'Immediate' or '2–4 weeks')",
    "notes":                  "string",
    "data_quality":           "'high' | 'medium' | 'low'",
    "last_verified":          "YYYY-MM-DD string"
  },

