# 8BitCommons Git attributes
# Handle line endings consistently (important on Windows)
* text=auto eol=lf

# Source code
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# Art & binary assets - do not attempt text conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text
*.psd binary
*.ai binary
*.mp3 binary
*.wav binary

# Recommend Git LFS for very large asset collections (10k+ high-res sprites, animations)
# Uncomment these lines and run `git lfs install` + `git lfs track` if needed:
# *.png filter=lfs diff=lfs merge=lfs -text
# *.gif filter=lfs diff=lfs merge=lfs -text
# art/generated/** filter=lfs diff=lfs merge=lfs -text

# Windows batch / PowerShell keep CRLF if preferred by team
# *.bat text eol=crlf
# *.ps1 text eol=crlf
